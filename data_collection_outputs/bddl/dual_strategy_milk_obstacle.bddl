(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the milk carton and place it into the wooden tray)
  (:regions
    (bin_region (:target floor) (:ranges ((-0.025 0.242 0.025 0.278))))
    (target_object_region (:target floor) (:ranges ((-0.16 -0.28 -0.08 -0.20))))
    (obstacle_region (:target floor) (:ranges ((-0.02 -0.03 0.02 0.03))))
    (contain_region (:target wooden_tray_1))
  )
  (:fixtures
    floor - floor
    obstacle_1 - white_storage_box
  )
  (:objects
    milk_1 - milk
    wooden_tray_1 - wooden_tray
  )
  (:obj_of_interest milk_1 wooden_tray_1)
  (:init
    (On milk_1 floor_target_object_region)
    (On wooden_tray_1 floor_bin_region)
    (On obstacle_1 floor_obstacle_region)
  )
  (:goal (And (In milk_1 wooden_tray_1_contain_region)))
)
